ethernet vpn0  {
    format_up = ": %ip"
    format_down = ": down"
}

wireless wlp4s0 {
    format_up = "\t[%essid, %bitrate] %ip"
    format_down = "W: down"
}

battery 0 {
     low_threshold = 10
     threshold_type = time
}

volume master {
    format = "\t%volume"
    device = "pulse"
    mixer = "Master"
    mixer_idx = 0
}


time {
    format = "%I:%M:%S %Y-%m-%d"
}