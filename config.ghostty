# --- Font ---
font-family  = "Berkeley Mono Medium"
# weight variant: Regular, Medium, Bold, Italic
font-style   = "Regular"
font-size    = 20
# makes glyphs bolder via macOS smoothing — helps on Retina, can look chunky on 1080p
font-thicken = true

# OpenType features
# contextual alternates (e.g. character-pair substitutions)
font-feature = calt
# standard ligatures (e.g. -> != =>)
font-feature = liga
# glyph composition/decomposition — safe default
font-feature = ccmp
# localized glyph variants — safe default
font-feature = locl
# Berkeley Mono stylistic set 8 — alternate glyph shapes
font-feature = ss08

# Slight breathing room between lines — easier to scan long code blocks
adjust-cell-height = 10%

# --- Theme ---
# theme = "Catppuccin Mocha"
# theme = "Nord"
# theme = "Gruvbox Dark"
# Light/dark switching: use the `light` / `dark` shell commands (defined in
# zsh/zshrc), which rewrite this one line. cmux ignores Ghostty's native
# dark:...,light:... auto-switch syntax, so we swap the theme explicitly.
theme = "Tokyo Night"

# Subtle, not glassy — keeps contrast for syntax highlighting
background-opacity = 0.95
background-blur    = 10

# --- Cursor ---
cursor-style              = block
# steady cursor is less distracting while reading code
cursor-style-blink        = false
cursor-click-to-move      = true
mouse-hide-while-typing   = true

# --- Window ---
window-padding-x          = 1
window-padding-y          = 1
window-padding-balance    = true
# restore tabs/windows on relaunch
window-save-state         = always
window-colorspace         = display-p3
window-decoration         = true
unfocused-split-opacity   = 0.6

# --- macOS ---
# required for ⌥-keys in nvim/tmux/zsh bindings
macos-option-as-alt       = true
# compact, native-feeling tabs
macos-titlebar-style      = tabs
macos-non-native-fullscreen = visible-menu
quit-after-last-window-closed = true

# --- Scrollback & shell ---
# ~100MB — generous for long build/test logs
scrollback-limit          = 100000000
shell-integration         = detect
shell-integration-features = cursor,sudo,title
copy-on-select            = clipboard
clipboard-read            = allow
clipboard-write           = allow
# warn on multi-line / suspicious paste
clipboard-paste-protection = true

# --- Bell & focus ---
# NOTE: `audible-bell` is not a valid Ghostty field (validation: "unknown field"),
# so it was silently ignored. Left commented out — Ghostty has no audible bell by default.
# audible-bell            = false
focus-follows-mouse       = false

# --- Working Directory ---
# new windows/tabs open in ~
working-directory                = home
# new tabs always go to ~, ignoring current dir
tab-inherit-working-directory    = false
# new windows always go to ~, ignoring current dir
window-inherit-working-directory = false

# --- Keybinds (coding niceties) ---
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+0=reset_font_size
keybind = cmd+k=clear_screen
keybind = cmd+shift+enter=toggle_fullscreen
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+w=close_surface
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom
