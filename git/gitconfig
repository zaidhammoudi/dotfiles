    email = 7748859+zaidhammoudi@users.noreply.github.com

[core]
    editor = nvim
    # renders diff/show/log output through delta instead of the default `less`
    pager = delta

[alias]
    prettylog = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    dm = diff --color-moved=plain
    last = diff HEAD~1 --stat

[color]
    ui = true

[branch]
    autoSetupMerge = always

[push]
    autoSetupRemote = true

[credential]
    helper = osxkeychain
    helper = /usr/local/share/gcm-core/git-credential-manager

[core]
    excludesfile = ~/.gitignore_global
    fsmonitor = true
    untrackedCache = true

[credential "https://dev.azure.com"]
    useHtpPath = true
