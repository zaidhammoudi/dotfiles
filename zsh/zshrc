# ============================================
# Pre-hooks
# ============================================

[ -f ~/.zsh_pre ] && source ~/.zsh_pre

# ============================================
# Core Settings
# ============================================

# Vim mode
set -o vi
bindkey 'jk' vi-cmd-mode

# History
setopt HIST_IGNORE_SPACE      # Do not record lines beginning with a space (useful for hiding secrets/passwords)
setopt HIST_FIND_NO_DUPS      # When searching history, don't show the same line twice
setopt HIST_SAVE_NO_DUPS      # When saving to the history file, older duplicate commands are omitted
setopt SHARE_HISTORY          # Share history between all active shell sessions in real-time

HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000

# ============================================
# Plugin Management (Zinit)
# ============================================

if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    mkdir -p "$HOME/.local/share/zinit" && chmod g-rwX "$HOME/.local/share/zinit"
    git clone https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git"
fi
source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

# ============================================
# Completions
# ============================================

fpath=(~/completions $fpath)
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
    compinit
else
    compinit -C
fi

# ============================================
# Plugins
# ============================================

# Theme
zinit light sindresorhus/pure

# FZF shell integration (binary managed by Homebrew)
(( $+commands[fzf] )) && source <(fzf --zsh)

# ============================================
# Environment
# ============================================

# FZF
if (( $+commands[fd] )); then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    _fzf_compgen_path() { fd --hidden --follow --exclude .git . "$1" }
    _fzf_compgen_dir() { fd --type d --hidden --follow --exclude .git . "$1" }
fi

# FZF_DEFAULT_OPTS (Catppuccin Latte/Mocha) is set by the theme section below,
# which swaps the palette to match the current light/dark mode.

# Less colors (for man pages)
export LESS_TERMCAP_md=$'\e[1;32m'
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_se=$'\e[0m'
export LESS_TERMCAP_so=$'\e[01;33m'
export LESS_TERMCAP_ue=$'\e[0m'
export LESS_TERMCAP_us=$'\e[1;4;31m'

export EDITOR=nvim

# Hashicorp autocomplete
for cmd in terraform consul vault nomad; do
    if (( $+commands[$cmd] )); then
        autoload -U +X bashcompinit && bashcompinit
        complete -o nospace -C $cmd $cmd
    fi
done

# ============================================
# Platform-specific
# ============================================

if [[ "$OSTYPE" == "darwin"* ]]; then

    export PATH="$PATH:$HOME/go/bin"

else

    # AWS completion
    if (( $+commands[aws_completer] )); then
        complete -C aws_completer aws
    fi

    export BROWSER=google-chrome-stable
    export PATH="$PATH:$HOME/bin"
    export PATH="$HOME/.local/bin:$PATH"

    # GVM (Go Version Manager) — lazy-loaded to avoid cd hook at startup
    if [[ -s "$HOME/.gvm/scripts/gvm" ]]; then
        gvm() {
            unfunction gvm
            source "$HOME/.gvm/scripts/gvm"
            gvm "$@"
        }
    fi

fi

# ============================================
# cmux / ghostty / fzf theme switching
# ============================================
# `light` / `dark` swap the cmux/ghostty theme (rewrites the single `theme =`
# line — cmux ignores Ghostty's dark:...,light:... auto syntax; apply with ⌘⇧,
# in cmux, or ⌘Q + reopen) AND the fzf palette, then persist the mode so new
# shells match.

_ghostty_config="$HOME/code/dotfiles/config.ghostty"
_ghostty_theme_dark="Tokyo Night"
_ghostty_theme_light="TokyoNight Day"
_theme_state="${XDG_STATE_HOME:-$HOME/.local/state}/theme-mode"

# Catppuccin fzf palettes — Mocha (dark) / Latte (light).
_fzf_opts_dark='--highlight-line
 --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8
 --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc
 --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8'
_fzf_opts_light='--highlight-line
 --color=bg+:#ccd0da,bg:#eff1f5,spinner:#dc8a78,hl:#d20f39
 --color=fg:#4c4f69,header:#d20f39,info:#8839ef,pointer:#dc8a78
 --color=marker:#dc8a78,fg+:#4c4f69,prompt:#8839ef,hl+:#d20f39'

_apply_fzf_theme() {
    if [[ "$1" == light ]]; then
        export FZF_DEFAULT_OPTS="$_fzf_opts_light"
    else
        export FZF_DEFAULT_OPTS="$_fzf_opts_dark"
    fi
}

_set_theme() {
    local mode="$1" name
    [[ "$mode" == light ]] && name="$_ghostty_theme_light" || name="$_ghostty_theme_dark"
    mkdir -p "${_theme_state:h}" 2>/dev/null
    print -r -- "$mode" > "$_theme_state"
    # Rewrite the active `theme =` line (tolerant of spacing). Theme names are
    # fixed constants with no sed-special chars, so the replacement is safe.
    # BSD sed (macOS) requires an explicit '' after -i; GNU sed (Linux) does not.
    if [[ "$OSTYPE" == "darwin"* ]]; then
        sed -i '' -E "s|^theme[[:space:]]*=.*|theme = \"${name}\"|" "$_ghostty_config"
    else
        sed -i -E "s|^theme[[:space:]]*=.*|theme = \"${name}\"|" "$_ghostty_config"
    fi
    if ! grep -q "^theme = \"${name}\"\$" "$_ghostty_config"; then
        echo "warning: no active 'theme =' line updated in $_ghostty_config" >&2
    fi
    _apply_fzf_theme "$mode"
    if [[ "$OSTYPE" == "darwin"* ]]; then
        echo "theme → $mode  (fzf updated; press ⌘⇧, in cmux to apply the terminal theme)"
    else
        echo "theme → $mode  (fzf updated; press ctrl+shift+, to reload Ghostty's config)"
    fi
}

light() { _set_theme light }
dark()  { _set_theme dark }

# Adopt the persisted mode's fzf palette on shell startup (default dark).
_apply_fzf_theme "$(cat "$_theme_state" 2>/dev/null)"

# ============================================
# Post-hooks
# ============================================

[ -f ~/.zsh_aliases ] && source ~/.zsh_aliases
[ -f ~/.zsh_post ] && source ~/.zsh_post
[ -f ~/.zsh_secrets ] && source ~/.zsh_secrets

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
