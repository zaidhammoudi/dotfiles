# ============================================
# Pre-hooks
# ============================================

[ -f ~/.zsh_pre ] && source ~/.zsh_pre

# ============================================
# Core Settings
# ============================================

# Vim mode
set -o vi
bindkey 'jk' vi-cmd-mode

# History
setopt HIST_IGNORE_SPACE      # Do not record lines beginning with a space (useful for hiding secrets/passwords)
setopt HIST_FIND_NO_DUPS      # When searching history, don't show the same line twice
setopt HIST_SAVE_NO_DUPS      # When saving to the history file, older duplicate commands are omitted
setopt SHARE_HISTORY          # Share history between all active shell sessions in real-time

HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000

# ============================================
# Plugin Management (Zinit)
# ============================================

if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    mkdir -p "$HOME/.local/share/zinit" && chmod g-rwX "$HOME/.local/share/zinit"
    git clone https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git"
fi
source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

# ============================================
# Completions
# ============================================

fpath=(~/completions $fpath)
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
    compinit
else
    compinit -C
fi

# ============================================
# Plugins
# ============================================

# Theme
zinit light sindresorhus/pure

# FZF shell integration (binary managed by Homebrew)
(( $+commands[fzf] )) && source <(fzf --zsh)

# ============================================
# Environment
# ============================================

# FZF
if (( $+commands[fd] )); then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    _fzf_compgen_path() { fd --hidden --follow --exclude .git . "$1" }
    _fzf_compgen_dir() { fd --type d --hidden --follow --exclude .git . "$1" }
fi

export FZF_DEFAULT_OPTS='
 --color=fg:242,bg:236,hl:65,fg+:15,bg+:239,hl+:108
 --color=info:108,prompt:109,spinner:108,pointer:168,marker:168
'

# Less colors (for man pages)
export LESS_TERMCAP_md=$'\e[1;32m'
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_se=$'\e[0m'
export LESS_TERMCAP_so=$'\e[01;33m'
export LESS_TERMCAP_ue=$'\e[0m'
export LESS_TERMCAP_us=$'\e[1;4;31m'

export EDITOR=nvim

# Hashicorp autocomplete
for cmd in terraform consul vault nomad; do
    if (( $+commands[$cmd] )); then
        autoload -U +X bashcompinit && bashcompinit
        complete -o nospace -C $cmd $cmd
    fi
done

# ============================================
# Platform-specific
# ============================================

if [[ "$OSTYPE" == "darwin"* ]]; then

    export PATH="$PATH:$HOME/go/bin"

else

    # AWS completion
    if (( $+commands[aws_completer] )); then
        complete -C aws_completer aws
    fi

    export BROWSER=google-chrome-stable
    export PATH="$PATH:$HOME/bin"
    export PATH="$HOME/.local/bin:$PATH"

    # GVM (Go Version Manager) — lazy-loaded to avoid cd hook at startup
    if [[ -s "$HOME/.gvm/scripts/gvm" ]]; then
        gvm() {
            unfunction gvm
            source "$HOME/.gvm/scripts/gvm"
            gvm "$@"
        }
    fi

fi

# ============================================
# Post-hooks
# ============================================

[ -f ~/.zsh_aliases ] && source ~/.zsh_aliases
[ -f ~/.zsh_post ] && source ~/.zsh_post
[ -f ~/.zsh_secrets ] && source ~/.zsh_secrets
